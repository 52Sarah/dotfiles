{
	"settings":
	{
		"color_scheme": "Packages/BlackBird-ColorScheme/BlackBird-Theme.tmTheme",

		"follow_symlinks": true,

	    // folder_exclude_patterns and file_exclude_patterns control which files
	    // are listed in folders on the side bar. These can also be set on a per-
	    // project basis.
	    "folder_exclude_patterns": [
	    	"*.BAK.*", 
	    	".git", ".svn", "CVS",
	    ],
	    "file_exclude_patterns": [
	    	"*.pyc", "*.pyo", 
	    	"*.exe", "*.dll", "*.obj",
	    	"*.o", "*.a", "*.lib", "*.so", "*.dylib", "*.class",
	    	"*.ncb", "*.sdf", "*.suo", "*.pdb", "*.idb", "*.psd", "*.db", 
	    	"*.sublime-workspace",
	    ],
	    
	},
	"folders":
	[
		{
			"name": "~/dotfiles",
			"path": "~/dotfiles"
		},
		{
			"name": "~/ch-bash-profile",
			"path": "~/ch-bash-profile",
	    "file_exclude_patterns": [
	    	".zprofile*", ".zshrc*",
	    ],
		},
		{
			"name": "~",
			"path": "~",
			"folder_include_patterns": [
				"bak",
				"bin",
				".docker",
				".jenv",
				".m2",
				"prefs",
				".pyenv",
				".ssh"
			],
			"file_include_patterns": [
				".bash_profile*",
				".git*",
				".secret*",
				".tick",
				".vault-token",
			],
		},
	]
}

