[alias]

  # -C - detect copied lines, even from other files in the same commit
  # -M - detect moved lines, even from other files in the same commit
  # -w - ignore whitespace
  bl = blame -C -M -w

  br-cp = branch -C
  br-mv = branch -M
  br-rm = branch -D
  br-su = branch --set-upstream-to
  br-uu = branch --unset-upstream

  br =  branch --list --ignore-case --sort=-committerdate --format="%(if)%(HEAD)%(then)%(color:magenta)*%(else)%(color:yellow)\\ %(end)%(objectname:short)\\ \\ %(color:reset)%(if)%(HEAD)%(then)%(color:magenta)%(end)%(align:12,left)%(committerdate:relative)%(end)\\ \\ %(if)%(HEAD)%(then)%(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:cyan)%(end)%(end)%(refname:short)%(color:white)\\ %(if)%(upstream)%(then)%(align:2,left)[%(upstream:trackshort)]%(end)%(end)%(color:reset)"
  br0 = br
  br1 = branch --list --ignore-case --sort=-committerdate --column=never --format="%(if)%(HEAD)%(then)%(color:magenta)*%(else)%(color:yellow)\\ %(end)%(objectname:short)\\ \\ %(color:reset)%(if)%(HEAD)%(then)%(color:magenta)%(end)%(align:14,left)%(committerdate:format:%D\\ %H:%M)%(end)\\ \\ %(align:20,left)%(authorname)%(end)\\ %(align:60,left)%(if)%(HEAD)%(then)%(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:cyan)%(end)%(end)%(refname:short)%(if)%(upstream)%(then)\\ %(color:white)%(align:2,left)[%(upstream:trackshort)]%(end)%(color:reset)%(end)%(end)\\ %(contents:subject)"
  br2 = branch --list --ignore-case --sort=-committerdate --column=never --format="%(if)%(HEAD)%(then)%(color:magenta)*%(else)%(color:yellow)\\ %(end)%(objectname:short)\\ \\ %(if)%(HEAD)%(then)%(color:magenta)%(else)%(color:reset)%(end)%(align:14,left)%(committerdate:format:%D\\ %H:%M)%(end)\\ \\ %(align:20,left)%(authorname)%(end)\\ %(align:60,left)%(if)%(HEAD)%(then)%(color:reset)%(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:cyan)%(else)%(color:reset)%(end)%(end)%(refname:short)%(color:cyan)%(if)%(upstream)%(then)\\ %(upstream:track)%(end)%(color:reset)%(end)\\ %(contents:subject)"
  br3 = br2

  co =    checkout
  co-d =  checkout develop
  co-m =  checkout main

  cp = cherry-pick --edit
  
  d =   diff
  ds =  diff --stat-graph-width=20
  dss = diff --shortstat
  dds = diff --dirstat
  
  dt =  difftool --dir-diff

  fet =   fetch --progress --verbose
  fett =  fetch --progress --verbose --tags

  # log format directives:
  #   %C    bold | red/cyan/... | reset
  #   %h    hash
  #   %d    refs
  #   %aN   author
  #   %ar   commit date
  #   $s    subject

  log1 = log --format='%n%C(yellow)commit %C(bold yellow)%h%Creset%C(bold cyan)%d%Creset%n%C(white)Author: %C(bold white)%aN%n%Creset%C(white)Date:   %C(bold white)%ar%Creset%n  %s'
  log2 = log --format='%n%C(dim)---------------%Creset%n%C(yellow)commit %C(bold yellow)%h%Creset%C(bold cyan)%d%Creset%n%C(white)Author: %C(bold white)%aN%n%Creset%C(white)Date:   %C(bold white)%ar%Creset%n  %s' --stat

  pff = pull --ff-only --progress
  prb = pull --rebase --progress

  pushup = push --set-upstream origin HEAD

  rab = rebase --abort
  rco = rebase --continue

  st =  status --short
  st1 = status --column=dense --no-show-stash
  # st2: Show files in columns
  st2 = status --column=nodense --show-stash
  # st3: Show files in columns, include ignored files; show diffs
  st3 = status --column=nodense --show-stash --ignored=traditional --verbose
	whatchanged = log --raw --no-merges

[blame]
  coloring = highlightRecent  # options: repeatedLines, highlightRecent, NONE
  date = format:%a %D %H:%M  # Thu 10/11/18 18:31

[branch]
  autoSetupMerge  = false
  autoSetupRebase = always
  sort = -committerdate

[checkout]
  defaultRemote = origin

# From: https://git-scm.com/docs/git-config#Documentation/git-config.txt-colorui
# Values are always|NEVER|auto, COLUMN|row|plain, dense|NODENSE
[column]
  #! ui = never,column,nodense
  branch = auto
  status = always  # nodense seems to have no effect on status (set here or on .ui)
  tag = always

[commit]
  verbose = true

[core]
  abbrev = 8
  #! commentChar = #
  editor = subl
  excludesFile = ~/.gitignore
  hooksPath = ~/.git_hooks
  pager = less
  whitespace = -trailing-space,tab-in-indent,tabwidth=2
  # whitespace defaults: space-before-tab, -indent-with-non-tab, -cr-at-eol

# See: https://git-scm.com/docs/git-config#Documentation/git-config.txt-diffdirstat  
#   .dirstat parameters: files|CHANGES|lines, cumulative|NONCUMULATIVE, 3 (cutoff %)
#   .relative 'true' only performs diff in current directory and below
#   .renames 'copies' detects renames and copies
#   .algorithm 'minimal' is slower but generates the smallest correct diff
[diff]
  algorithm = minimal
  colorMoved = true
  context=2  # default: 3
  dirstat = lines,cumulative,0
  relative = true
  renames = copies
  # statGraphWidth = 20

[fetch]
  output = compact  # branchName -> origin/* instead of origin/branchName
  #! prune = true
  #! showForcedUpdates = true
  writeCommitGraph = true

[grep]
  fallbackToNoIndex = true
  lineNumber = true
  patternType = extended

[log]
  abbrevCommit = true  #! false
  #! conflictStyle = merge
  date = human-local #!iso
  decorate = full     # none|short|full|AUTO
  follow = true
  #! mailmap = true

[mailmap]
  file = ~/.mailmap

[merge]
  #! autoStash = false
  directoryRenames = true  # default: conflict
  ff = only
  guitool = bc
  renames = copies
  #! stat = true
  tool = bc
  #! verbosity = 2  # 2 is conflicts and file changes

[mergetool "bc"]
  trustExitCode = true

[pull]
  ff = only
  rebase = true

[push]
  #! default = simple  # upstream unless name is different
  useForceIfIncludes = true  # minimize explicit forces

[rebase]
  #! autoSquash = false
  #! autoStash = false
  missingCommitsCheck = warn
  stat = true

[remote]
  #! pushDefault = origin

[remote "master"]
  pushDefault = PULL_REQUEST_YO

[reset]
  #! quiet = false

[stash]
  #! showStat = true
  #! showPatch = false

# by default, full "status" command is complete; "s" alias is terse
[status]
  aheadBehind = true
  branch = true  # only relevant for short=true
  displayCommentPrefix = true
  relativePaths = false  # TRUE: relative to PWD; false: to repo root
  renames = copies
  #! short = false
  showStash = true
  #! showUntrackedFiles = normal  # options: no|NORMAL|all


### available colors, attributes
# - normal, black, red, green, yellow, blue, magenta, cyan, or white
# - bold, dim, ul (underline), blink, and reverse
[include]
  path = .gitconfig__colors


