# Ignore case distinctions in PATTERN, only if PATTERN contains no upper case.
# --smart-case, -S, --nosmart-case; -i, --ignore-case, -I
--no-ignore-case

# Suppress error messages about nonexistent or unreadable files.
-s

# Direct ack's output through program.
--pager=less

# Print a filename heading above, and/or a break between, each file's results.
# --[no]heading, --[no]break
# Same as --heading --break, --nodheading --nobreak.
# --group, --nogroup   
--group

# Sort the found files lexically.
--sort-files

# Add/remove directory from list of ignored dirs.
# --[no]ignore-dir=name
--ignore-dir=.idea
--ignore-dir=build
--ignore-dir=gradle
--ignore-dir=schemaspy-out

# Add filter for ignoring files.
# --ignore-file=FILTER:ARGS
--ignore-file=ext:sublime-workspace
--ignore-file=is:gradlew,gradlew.bat
--ignore-file=is:gradlew,gradlew.bat

# Recurse into subdirectories (default: on)
# -r, -R, --recurse; -n, --no-recur--recurse

# Follow symlinks.  Default is off.
# --follow, --nofollow                  
--follow                  

--type-set
    config:ext:properties,xml,yaml,yml
--type-set
    data:ext:csv,json,sql
--type-set
    log:match:/\.log(\..+)?$/
