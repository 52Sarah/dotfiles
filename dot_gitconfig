[alias]

  a = add --verbose

  # -C - detect moved or copied lines, even from other files in the same commit
  # -w - ignore whitespace
  bl = blame -C -w

  br = branch
  brcp = branch -C
  brmv = branch -M

  # $ git brr
  # SHA....8 * branch_name...................................48   authrdt__rel.15   subject...
  #
  # %(if)%(HEAD)%(then)%(objectname:short) * %(else)%(objectname:short)   %(end)
  # ___%(align:48,left)%(refname:short)%(end)
  # ___%(align:15,left)%(authordate:relative)%(end)
  # ___%(contents:subject)
  brr = !git branch --ignore-case --list \
    --sort='-authordate' \
    --format='%(if)%(HEAD)%(then)%(objectname:short) * %(else)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)   %(align:15,left)%(authordate:relative)%(end)   %(contents:subject)' \
    'master' 'user*' |\
    awk -v LEN=150 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'

  # $ git brrr
  # SHA....8 * branch_name...................................48  authrdt__iso.15  author_name........21  subject...
  #
  # local branches' refname start with ref/heads; remote, refs/remotes
  #
  # %(if)%(HEAD)%(then)%(objectname:short) * %(else)%(objectname:short)   %(end)
  # %(align:48,left)%(refname:short)%(end)
  # __%(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)
  # __%(align:21,left)%(authorname)%(end)
  # __%(contents:subject)
  brrr = !git branch --ignore-case --list --all \
    --sort='-authordate' --sort='refname:rstrip=-3' \
    --format='%(if)%(HEAD)%(then)%(objectname:short) * %(else)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)  %(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)  %(align:21,left)%(authorname)%(end)  %(contents:subject)  %(symref)' |\
    awk -v LEN=175 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'

  co = checkout --progress
  com = checkout --progress master

  cp = cherry-pick --edit --ff
  
  d = diff
  ds = diff --stat
  dsc = diff --stat --compact-summary
  dds = diff --dirstat
  ddsc = diff --dirstat --compact-summary

  f = fetch --progress

  # Insert command line arguments at the end of the log command rather than at the end of the entire command
  # line, since they would be applied to less there.
  l = !args="\"${@:--30}\"" && shift "$#" &&\
    git log -10 --pretty=briefest --date='format:%a %m/%d %H:%M' --use-mailmap "$args" |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less

  ll = !args="\"${@:--10}\"" && shift "$#" &&\
    git log --pretty=briefer --use-mailmap "$args" |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less

  lll = !args="\"${@:--10}\"" && shift "$#" &&\
    git log --no-use-mailmap --source "$args" |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less

  llll = !args="\"$@\"" && shift "$#" &&\
    git log --pretty=brief --compact-summary --no-use-mailmap --source "$args" |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less



  # Enhance git checkout with post-update hook, which pushes branch names into $git_dir/HEADS
  # for this function to pop.
  popb = !git-popb.sh

  pff   = pull --ff-only --progress
  pullf = pull --ff-only --progress
  pullr = pull --rebase --progress

  pushup = push --set-upstream origin HEAD

  rc = rebase --continue

  s = !args="\"$@\"" && shift "$#" &&\
    git status --short "$args" |\
    grep -E \
      -v '^[^ ]{2,} .*/?(.*(-localer|logback-test).(xml|ya?ml|properties)|\\.log/|\\.mvn/|\\.run/|mvnw.*)$'
  st = !args="\"$@\"" && shift "$#" &&\
    git status --column=dense --no-show-stash "$args" |\
    grep -E -v "^\\#?\\s*\\$"
  stt = !args="\"$@\"" && shift "$#" &&\
    git status --column=nodense --show-stash "$args" |\
    grep -E -v "^\\#?\\s*\\$"
  sttt = !args="\"$@\"" && shift "$#" &&\
    git status --column=nodense --ignored --show-stash "$args" |\
    grep -E -v "^\\#?\\s*\\$"


[blame]
  coloring = highlightRecent  # options: repeatedLines, highlightRecent, NONE
  date = format:%a %D %H:%M  # Thu 10/11/18 18:31

[branch]
  autoSetupMerge  = false
  autoSetupRebase = always
  sort = refname

[checkout]
  defaultRemote = origin

# ui provides the default for all other commands
[color]
  ui     = always
  #! advice = always
  #! branch = always
  #! diff   = always
  #! grep   = always
  #! interactive = always
  #! pager = true
  #! push = always
  #! remote = always
  #! showBranch = always
  #! status = always
  #! transport = always

# From: https://git-scm.com/docs/git-config#Documentation/git-config.txt-colorui
# Values are always|NEVER|auto, COLUMN|row|plain, dense|NODENSE
[column]
  #! ui = never,column,nodense
  branch = always,dense
  status = always  # nodense seems to have no effect on status (set here or on .ui)
  tag = always

[commit]
  verbose = true

[core]
  abbrev = 6
  #! commentChar = #
  editor = subl
  excludesFile = ~/.gitignore
  hooksPath = ~/.git_hooks
  pager = less
  whitespace = -trailing-space,tab-in-indent,tabwidth=2
  # whitespace defaults: space-before-tab, -indent-with-non-tab, -cr-at-eol

[credential]
  helper = osxkeychain

# See: https://git-scm.com/docs/git-config#Documentation/git-config.txt-diffdirstat  
#   .dirstat parameters: files|CHANGES|lines, cumulative|NONCUMULATIVE, 3 (cutoff %)
#   .relative 'true' only performs diff in current directory and below
#   .renames 'copies' detects renames and copies
#   .algorithm 'minimal' is slower but generates the smallest correct diff
[diff]
  algorithm = minimal
  colorMoved = true
  context=2  # default: 3
  dirstat = lines,cumulative,0
  relative = true
  renames = copies
  # statGraphWidth = 20
  tool = bc3

[fetch]
  output = compact  # branchName -> origin/* instead of origin/branchName
  #! prune = true
  #! showForcedUpdates = true
  writeCommitGraph = true

[grep]
  fallbackToNoIndex = true
  lineNumber = true
  patternType = extended

[log]
  #! abbrevCommit = false
  #! conflictStyle = merge
  date = format:%a %D %H:%M  # Thu 10/11/18 18:31
  #! decorate = short
  follow = true
  #! mailmap = true

[mailmap]
  file = /Users/toddpierzina/.mailmap

[merge]
  #! autoStash = false
  directoryRenames = true  # default: conflict
  ff = only
  guitool = bc3
  renames = copies
  #! stat = true
  tool = bc3
  #! verbosity = 2  # 2 is conflicts and file changes

[mergetool "bc3"]
  trustExitCode = true

# %h  - abbrev hash
# %C  - color or reset
# %cn or %an - committer|author name; %cN via .mailmap
# %ce or %ae - committer|author email; %cE via .mailmap
# %cd - commit|author date in --date's format
# %cr - commit|author date (relative)
# %D  - ref name(s)
# %s  - subject line
[pretty]
  # commit(abbrev), author (mailmap), date, subject, [ref names]
  briefest = %h  %<(20,trunc)%aN  %ad  %<(15)%cr %<(64,trunc)%s %>>(1)%d

  # commit(abbrev), author, date (rel date), [ref names]; subject
  briefer = %h  %<(25,trunc)%an  %ad  (%ar)  %>>(1)%d%n    %s

  # commit(abbrev), author, date (rel date), [ref names]; subject; summary
  brief = %n%h  %<(25,trunc)%an  %ad  (%ar)  %>>(1)%d%n    %s

[pull]
  ff = only
  rebase = true

[push]
  #! default = simple  # upstream unless name is different
  useForceIfIncludes = true  # minimize explicit forces

[rebase]
  #! autoSquash = false
  #! autoStash = false
  missingCommitsCheck = warn
  stat = true

[remote]
  #! pushDefault = origin

[remote "master"]
  pushDefault = PULL_REQUEST_YO

[reset]
  #! quiet = false

[stash]
  #! showStat = true

# by default, full "status" command is complete; "st" alias is terse
[status]
  aheadBehind = true
  branch = true  # only relevant for short=true
  displayCommentPrefix = true
  relativePaths = false  # TRUE: relative to PWD; false: to repo root
  renames = copies
  #! short = false
  showStash = true
  #! showUntrackedFiles = normal  # options: no|NORMAL|all

