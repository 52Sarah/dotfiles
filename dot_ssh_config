# BEGIN ANSIBLE MANAGED BLOCK BASTION
Host bastion.aws.*.cchh.io
  LocalForward 15001 postgres.dev.cchh.local:5432
  User toddpierzina
  IdentityFile ~/.ssh/id_rsa
#!  IdentitiesOnly yes
#!  ProxyCommand none
#!  ControlMaster auto
#!  ControlPath ~/.ssh/%C
#!  ControlPersist 10m
  UseKeychain no
  AddKeysToAgent no
# END ANSIBLE MANAGED BLOCK BASTION
# BEGIN ANSIBLE MANAGED BLOCK ALL HOSTS
Host *
  User toddpierzina
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes
# END ANSIBLE MANAGED BLOCK ALL HOSTS


Host postgres_*
  HostName bastion.aws.uswest1.cchh.io
  ExitOnForwardFailure yes
  Port 5432
  ProxyCommand None

Host postgres_dev
  LocalForward 15001 appclusterk8sdevdbinstancedevauw2.cmluccto0ter.us-west-2.rds.amazonaws.com:5432

Host postgres_testing
  LocalForward 15002 10.255.0.2:5432
  
Host postgres_uat
