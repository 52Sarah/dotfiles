#! .gitconfig

[alias]

  # $ git brr
  # SHA....8 * branch_name...................................48   authrdt__rel.15   subject...
  #
  # %(color:reset)
  # %(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:white)%(end)
  # %(if)%(HEAD)%(then)%(color:bold green)%(objectname:short) * %(else)%(objectname:short)   %(end)
  # ___%(align:48,left)%(refname:short)%(end)
  # ___%(align:15,left)%(authordate:relative)%(end)
  # ___%(contents:subject)
  brr = !git branch --ignore-case --list \
    --sort='-authordate' \
    --format='%(color:reset)%(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:normal)%(end)%(if)%(HEAD)%(then)%(color:bold green)%(objectname:short) * %(else)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)   %(align:15,left)%(authordate:relative)%(end)   %(contents:subject)' \
    'master' 'user*' |\
    awk -v LEN=150 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'

  # $ git brrr
  # SHA....8 * branch_name...................................48  authrdt__iso.15  author_name........21  subject...
  #
  # local branches' refname start with ref/heads; remote, refs/remotes
  #
  # %(color:reset)
  # %(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)
  #   %(color:red)
  # %(else)
  #   %(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:normal)%(end)
  # %(end)
  # %(if)%(HEAD)%(then)%(color:bold green)% * %(else)   %(end)
  # %(objectname:short)
  # %(align:48,left)%(refname:short)%(end)
  # __%(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)
  # __%(align:21,left)%(authorname)%(end)
  # __%(contents:subject)
  brrr = !git branch --ignore-case --list --all \
    --sort='-authordate' --sort='refname:rstrip=-3' \
    --format='%(color:reset)%(if)%(HEAD)%(then)%(color:bold green)%(objectname:short) * %(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:red)%(else)%(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:normal)%(end)%(end)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)  %(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)  %(align:21,left)%(authorname)%(end)  %(contents:subject)  %(symref)' |\
    awk -v LEN=175 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'


