[alias]


  b = branch

  co = checkout
  com = checkout master
  cod = checkout develop

  cm = !args="$@" && shift "$#" && git commit --message "\"$args\"" && git diff --stat=$COLUMNS HEAD^ | grep -E -v '[0-9]+ (files? changed|insertions?|deletions?)'
  cma = !args="$@" && shift "$#" && git commit --all --message "\"$args\"" && git diff --stat=$COLUMNS HEAD^ | grep -E -v '[0-9]+ (files? changed|insertions?|deletions?)'

  cp = cherry-pick
  
  df = diff
  dfs = diff --stat
  dfds = diff --dirstat

  f = fetch --progress --verbose
  ft = f --tags

# LOG/PRETTY FORMAT FIELDS
# %h  - abbrev hash
# %C  - color or reset
# %cn - committer name; %cN via .mailmap
# %ce - committer email; %cE via .mailmap
# %cl - committer email local part; %cL via .mailmap
# %cd - commit date in --date's format
# %cr - commit date (relative)
# %D  - ref name(s)
# %s  - subject line

  # $ git l
  # SHA..6 author_name...16 author_date_med.18 auth_dt_rel_14 subject (tags)
  l = !args="\"$@\"" && shift "$#" &&\
    color_dc="$(git config --get color.diff.commit)" && color_dc="${color_dc##* }" &&\
    color_ds="$(git config --get color.decorate.stash)" && color_ds="${color_ds##* }" &&\
    color_dt="$(git config --get color.decorate.tag)" && color_dt="${color_dt##* }" &&\
    git log -10 --date=human --use-mailmap \
      --format='%C('"$color_dc"')%h %C(reset) %<(16,trunc)%aN %<(18)%C('"$color_ds"')%ad %<(14)%C(bold)%cr%C(reset) %<(64,trunc)%s %>>(1)%C('"$color_dt"')%d%C(reset)' \
      "$args" |\
    sed -E \
      -e "s:user/$USER:\\$ME:g" \
      -e 's/ -> /->/g' \
      -e 's/origin/$OR/g' \
      -e 's/tag: /t:/g' |\
    less

  # SHA..6  author_name.......20  author_date_med.18 auth_dt_rel_14 (tags)
  #     subject
  ll = !args="\"$@\"" && shift "$#" &&\
    color_dc="$(git config --get color.diff.commit)" && color_dc="${color_dc##* }" &&\
    color_ds="$(git config --get color.decorate.stash)" && color_ds="${color_ds##* }" &&\
    color_dt="$(git config --get color.decorate.tag)" && color_dt="${color_dt##* }" &&\
    git log -10 --date=human --use-mailmap \
      --format='%C('"$color_dc"')%h%C(reset)  %<(20)%aN  %<(18)%C('"$color_ds"')%ad %C(bold)(%ar)%C(reset)  %>>(1)%C('"$color_dt"')%d%C(reset)%n    %s' \
      "$args" |\
    sed -E \
      -e "s:user/$USER:\\$ME:g" \
      -e 's/ -> /->/g' \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less

  # SHA..6  author_name............25  author_date_med.18 auth_dt_rel_14 (tags)
  #     subject
  #  compact summary
  lll = !args="\"$@\"" && shift "$#" &&\
    color_dc="$(git config --get color.diff.commit)" && color_dc="${color_dc##* }" &&\
    color_ds="$(git config --get color.decorate.stash)" && color_ds="${color_ds##* }" &&\
    color_dt="$(git config --get color.decorate.tag)" && color_dt="${color_dt##* }" &&\
    git log -10 --date='format:%a %D %H:%M' --compact-summary --no-use-mailmap \
      --format='%C('"$color_dc"')%h%C(reset)  %<(25)%an  %C('"$color_ds"')%<(18)%ad %C(bold)(%cr)%C(reset)  %>>(1)%C('"$color_dt"')%d%C(reset)%n    %s' \
      "$args" |\
    sed -E \
      -e "s:user/$USER:\\$ME:g" \
      -e 's/ -> /->/g' \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less

  llll = !args="\"$@\"" && shift "$#" &&\
    git log -10 --compact-summary --no-use-mailmap --source "$args" |\
    sed -E \
      -e "s:user/$USER:\\$ME:g" \
      -e 's/ -> /->/g' \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g' |\
    less


  # Enhance git checkout with post-update hook, which pushes branch names into $git_dir/HEADS
  # for this function to pop.
  popb = !git-popb.sh

  pff   = pull --ff-only --progress
  pullf = pull --ff-only --progress
  pullr = pull --rebase --progress

  pushup = push --set-upstream origin HEAD

  rc = rebase --continue

  #
  # GIT STATUS VARIANTS, from terse to verbose
  #
  s = status --short
  #
  # Don't include hint text; show files in dense columns.
  st = !args="\"$@\"" && shift "$#" &&\
    git -c advice.statusHints=false status --column=dense --no-show-stash "$args" |\
    grep -E -v "^\\#?\\s*\\$" |\
    sed -E -e "s/\\'\\(.+\\)\\'/\\'$(git config --get-color color.status.remotebranch)\\\\1$(git config --get-color '' reset)\\'/;"
  #
  # Show files in columns; include stash count.
  stt = !args="\"$@\"" && shift "$#" &&\
    git status --column=nodense --show-stash "$args" |\
    sed -E \
      -e "s/\\'\\(.+\\)\\'/\\'$(git config --get-color color.status.remotebranch)\\\\1$(git config --get-color '' reset)\\'/" \
      -e "s/\\(stash.+has\\ \\)\\([[:digit:]]+\\)\\(\\ entries\\)/\\\\1$(git config --get-color color.decorate.stash)\\\\2$(git config --get-color '' reset)\\\\3/"
  # 
  # Show files in columns; include ignored files; include stash count.
  sttt = !args="\"$@\"" && shift "$#" &&\
    git status --column=nodense --ignored --show-stash "$args" |\
    sed -E \
      -e "s/\\'\\(.+\\)\\'/\\'$(git config --get-color color.status.remotebranch)\\\\1$(git config --get-color '' reset)\\'/" \
      -e "s/\\(stash.+has\\ \\)\\([[:digit:]]+\\)\\(\\ entries\\)/\\\\1$(git config --get-color color.decorate.stash)\\\\2$(git config --get-color '' reset)\\\\3/"


[blame]
  coloring = highlightRecent  # options: repeatedLines, highlightRecent, NONE
  date = format:%a %D %H:%M  # Thu 10/11/18 18:31

[branch]
  autoSetupMerge  = false
  autoSetupRebase = always
  sort = -authordate

[checkout]
  defaultRemote = origin

# From: https://git-scm.com/docs/git-config#Documentation/git-config.txt-colorui
# Values are always|NEVER|auto, COLUMN|row|plain, dense|NODENSE
[column]
  #! ui = never,column,nodense
  branch = auto
  status = always  # nodense seems to have no effect on status (set here or on .ui)
  tag = always

[commit]
  verbose = true

[core]
  abbrev = 7
  #! commentChar = #
  editor = subl
  excludesFile = ~/.gitignore
  hooksPath = ~/.git_hooks
  pager = less
  whitespace = -trailing-space,tab-in-indent,tabwidth=2
  # whitespace defaults: space-before-tab, -indent-with-non-tab, -cr-at-eol

[credential]
  helper = osxkeychain

# See: https://git-scm.com/docs/git-config#Documentation/git-config.txt-diffdirstat  
#   .dirstat parameters: files|CHANGES|lines, cumulative|NONCUMULATIVE, 3 (cutoff %)
#   .relative 'true' only performs diff in current directory and below
#   .renames 'copies' detects renames and copies
#   .algorithm 'minimal' is slower but generates the smallest correct diff
[diff]
  algorithm = minimal
  colorMoved = true
  context=2  # default: 3
  dirstat = lines,cumulative,0
  relative = true
  renames = copies
  # statGraphWidth = 20
  tool = bc3

[fetch]
  output = compact  # branchName -> origin/* instead of origin/branchName
  #! prune = true
  #! showForcedUpdates = true
  writeCommitGraph = true

[grep]
  fallbackToNoIndex = true
  lineNumber = true
  patternType = extended

[log]
  abbrevCommit = true  #! false
  #! conflictStyle = merge
  date = human #!iso
  #! decorate = short     # none|SHORT|full|auto
  follow = true
  #! mailmap = true

[mailmap]
  file = /Users/dad/.mailmap

[merge]
  #! autoStash = false
  directoryRenames = true  # default: conflict
  ff = only
  guitool = bc3
  renames = copies
  #! stat = true
  tool = bc3
  #! verbosity = 2  # 2 is conflicts and file changes

[mergetool "bc3"]
  trustExitCode = true

[pull]
  ff = only
  rebase = true

[push]
  #! default = simple  # upstream unless name is different
  useForceIfIncludes = true  # minimize explicit forces

[rebase]
  #! autoSquash = false
  #! autoStash = false
  missingCommitsCheck = warn
  stat = true

[remote]
  #! pushDefault = origin

[remote "master"]
  pushDefault = PULL_REQUEST_YO

[reset]
  #! quiet = false

[stash]
  #! showStat = true

# by default, full "status" command is complete; "st" alias is terse
[status]
  aheadBehind = true
  branch = true  # only relevant for short=true
  displayCommentPrefix = true
  relativePaths = false  # TRUE: relative to PWD; false: to repo root
  renames = copies
  #! short = false
  showStash = true
  #! showUntrackedFiles = normal  # options: no|NORMAL|all

[user]
  name = Todd Pierzina
  email = todd.pierzina@collectivehealth.com


#
### available colors, attributes
#
#
# normal, black, red, green, yellow, blue, magenta, cyan, or white
# bold, dim, ul (underline), blink, and reverse

[include]
  path = .gitconfig__colors
  
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
