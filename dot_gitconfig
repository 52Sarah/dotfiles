[alias]

  # -C - detect copied lines, even from other files in the same commit
  # -M - detect moved lines, even from other files in the same commit
  # -w - ignore whitespace
  bl = blame -C -M -w

  b = branch
  
  brcp =  branch -C
  brmv =  branch -M
  brrm =  branch -D
  brdel = branch -D

  br =    !bash -li -c 'git-branch 1'
  brr =   !bash -li -c 'git-branch 2'
  brrr =  !bash -li -c 'git-branch 3'

  co =    checkout
  com =   checkout master
  cod =   checkout develop

  cm =    !bash -li -c 'git-commit-message'
  cma =   cm --all

  cp =    cherry-pick
  
  d =     diff
  ds =    diff --stat-graph-width=20
  dss =   diff --shortstat
  dds =   diff --dirstat
  dt =    difftool --dir-diff

  f =     fetch --progress --verbose
  ft =    fetch --tags

  l= log
  lo = !bash -li -c 'git-log 1'
  loo = !bash -li -c 'git-log 2'
  looo = !bash -li -c 'git-log 3'

  # Enhance git checkout with post-update hook, which pushes branch names into $git_dir/HEADS
  # for this function to pop.
  popb = !git-popb.sh

  pff   = pull --ff-only --progress
  pullf = pull --ff-only --progress
  pullr = pull --rebase --progress

  pushup = push --set-upstream origin HEAD

  rab =   rebase --abort
  rc =    rebase --continue

  s = status --short
  st = !bash -li -c 'git-status 1'
  stt = !bash -li -c 'git-status 2'
  sttt = !bash -li -c 'git-status 3'
