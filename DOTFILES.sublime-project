{
	"settings":
	{
		"follow_symlinks": true,

    // folder_exclude_patterns and file_exclude_patterns control which files
    // are listed in folders on the side bar. These can also be set on a per-
    // project basis.
    "folder_exclude_patterns": [
    	"*.BAK.*", 
    	".git", ".svn", "CVS",
    ],
	},
	"folders":
	[
		{
			"path": "."
		},
    {
      "name": "~",
      "path": "~",
      "folder_include_patterns": [
        ".*",
        ".*/*"
      ],
      "folder_exclude_patterns": [
        ".android",
        ".bash_sessions",
        ".cups",
        ".npm",
        ".Trash",
        ".vmware",
        ".gradle/caches", ".gradle/daemon", ".gradle/jdks", ".gradle/native", ".gradle/.tmp", ".gradle/workers", ".gradle/wrapper",
        ".sdkman/libexec", ".sdkman/tmp",
      ],
      "file_include_patterns": [
        ".*/*",
        ".bashrc*",
        ".bash_profile*",
        ".bash_login*",
        ".profile*",
        ".secrets",
      ],
    },
    {
      "name": "~/Workspace/dotfiles",
      "path": "~/Workspace/dotfiles",
    },
	]
}

