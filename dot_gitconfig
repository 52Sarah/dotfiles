[alias]

  a = add --verbose

  # -C - detect moved or copied lines, even from other files in the same commit
  # -w - ignore whitespace
  bl = blame -C -w --abbrev=3

  b = branch
  br = branch

  # %(color:reset)
  # %(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)
  #   %(color:blue)
  # %(else)
  #   %(color:white)
  # %(end)
  # %(if)%(HEAD)%(then)
  #   %(color:bold green)
  #   %(objectname:short)
  #    _*_
  # %(else)
  #   %(objectname:short)
  #   ___
  # %(end)
  # ___%(align:48,left)%(refname:short)%(end)
  # ___%(align:15,left)%(authordate:relative)%(end)
  # ___%(contents:subject)
  brr = !git branch --ignore-case --list \
      --sort='-authordate' \
      --format='%(color:reset)%(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:normal)%(end)%(if)%(HEAD)%(then)%(color:bold green)%(objectname:short) * %(else)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)   %(align:15,left)%(authordate:relative)%(end)   %(contents:subject)' \
      'master' 'user*' |\
    awk -v LEN=150 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'

  # local branches' refname start with ref/heads; remote, refs/remotes
  #
  # %(color:reset)
  # %(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)
  #   %(color:red)
  # %(else)
  #   %(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)
  #     %(color:blue)
  #   %(else)
  #     %(color:normal)
  #   %(end)
  # %(end)
  # %(if)%(HEAD)%(then)
  #   %(color:bold green)%
  #   _*_
  # %(else)
  #   ___
  # %(end)
  # %(objectname:short)
  # %(align:48,left)%(refname:short)%(end)
  # __%(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)
  # __%(align:21,left)%(authorname)%(end)
  # __%(contents:subject)
  brrr = !git branch --ignore-case --list --all \
    --sort='-authordate' --sort='refname:rstrip=-3' \
    --format='%(color:reset)%(if)%(HEAD)%(then)%(color:bold green)%(objectname:short) * %(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:red)%(else)%(if:equals=refs/heads/xmerged)%(refname:rstrip=-3)%(then)%(color:blue)%(else)%(color:normal)%(end)%(end)%(objectname:short)   %(end)%(align:48,left)%(refname:short)%(end)  %(align:15,left)%(authordate:format:%a %m/%d %H:%M)%(end)  %(align:21,left)%(authorname)%(end)  %(contents:subject)  %(symref)' |\
    awk -v LEN=175 '{ if (LEN<=0 || length()<=LEN) {print $0} else {printf (\"%-\" LEN \".\" LEN \"s...\\n\"), $0} }'

  co = checkout
  com = checkout master

  cp = cherry-pick
  
  ds = diff --stat --compact-summary

  f = fetch

  # Insert command line arguments at the end of the log command rather than at the end of the entire command
  # line, since they would be applied to less there.
  # echo = !"a=; while [[ "$1" ]]; do echo "\\$1=$1"; echo "\\$@=$@"; a="\"$a $1\""; echo "a=$a"; shift 1; done; echo "a=/$a/""
  # echo = !args="\"${@:--10}\"" && echo "args=/$args/" && shift "$#" && echo "\\$@=/$@/"
  # echo = !args="\"${@:--10}\"" && shift "$#"

  l = !args="\"${@:--10}\"" && shift "$#" &&\
    git log -10 --pretty=briefest --date='format:%a %m/%d %H:%M' --use-mailmap "$args"  |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g'  |\
    less
  ll = !args="\"${@:--10}\"" && shift "$#" &&\
    git log --pretty=briefer "$args"  |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g'  |\
    less
  lll = !args="\"${@:--10}\"" && shift "$#" &&\
    git log --pretty=brief --compact-summary "$args"  |\
    sed -E \
      -e 's:HEAD -> :H->:' \
      -e "s:user/$USER:\\$US:g" \
      -e 's:origin:$OR:g' \
      -e 's/tag: /t:/g'  |\
    less


  # Enhance git checkout with post-update hook, which pushes branch names into $git_dir/HEADS
  # for this function to pop.
  popb = !git-popb.sh

  pff   = pull --ff-only
  pullf = pull --ff-only
  pullr = pull --rebase

  puh = push --set-upstream origin HEAD

  rc = rebase --continue

  s = status
  st = !git status --short  |\
    grep -E \
        -v '^[^ ]{2,} .*/?(.*(-localer|logback-test).(xml|ya?ml|properties)|\\.DS_Store|\\.log/|\\.mvn/|\\.run/|mvnw.*)$'
  stt = status -uno

[blame]
    coloring = highlightRecent
    date = format:%a %D %H:%M  # Thu 10/11/18 18:31

[branch]
    autoSetupMerge  = false
    autoSetupRebase = always
    sort = refname

[color]
    branch = always
    diff   = always
    grep   = always
    ui     = always

[color.blame]
    highlightRecent = blue,6.months.ago,normal,2.months.ago,yellow,2.weeks.ago,red
    repeatedLines = green  # seems to have no effect

[color.branch]
    current = green
    local = normal
    remote = magenta
    upstream = red
    plain = yellow

[color.status]
    branch = green
  

[core]
    editor = subl
    excludesFile = ~/.gitignore
    pager = less  #default
    whitespace = -trailing-space,tab-in-indent,tabwidth=2
    # whitespace defaults: space-before-tab, -indent-with-non-tab, -cr-at-eol

[diff]
    renames = copies
    relative = true
    statGraphWidth = 20
    tool = bc3

[fetch]
    prune = true  # default
    showForcedUpdates = true
    writeCommitGraph = true  # default

[log]
    abbrevCommit = true
    date = format:%a %D %H:%M  # Thu 10/11/18 18:31
    decorate = short
    mailmap = false

[mailmap]
    file = ~/.mailmap

[merge]
    ff = only
    tool = bc3

[mergetool "bc3"]
    trustExitCode = true

# %h  - abbrev hash
# %C  - color or reset
# %cn - committer name
# %cN - committer name, via .mailmap
# %ce - committer email
# %cE - committer email, via .mailmap
# %cl - committer email local part
# %cl - committer local part, via .mailmap
# %cd - commit date in --date's format
# %cr - commit date (relative)
# %D  - ref name(s)
# %s  - subject line
[pretty]
    # commit(abbrev), author (mailmap), date, subject, [ref names]
    briefest = %Cgreen%h%Creset  %<(10,trunc)%cN  %C(yellow)%cd  %<(15)%C(bold yellow)%cr%Creset %<(64,trunc)%s %>>(1)%Cblue%d%Creset

    # commit(abbrev), author, date (rel date), [ref names]; subject
    briefer = %Cgreen%h%Creset  %<(25)%cn  %C(yellow)%cd  %C(bold yellow)(%cr)%Creset  %>>(1)%Cblue%d%Creset%n    %s

    # commit(abbrev), author, date (rel date), [ref names]; subject; summary
    brief = %n%Cgreen%h%Creset  %<(25)%cn  %C(yellow)%cd  %C(bold yellow)(%cr)%Creset  %>>(1)%Cblue%d%Creset%n    %s

[pull]
    ff = only
    rebase = true

[rebase]
    stat = true

# by default, full "status" command is complete; "st" alias is terse
[status]
    aheadBehind = true
    branch = true
    renames = copies
    short = false  # default
    showStash = true
    showUntrackedFiles = normal  # default

[user]
    name = Todd Pierzina
    email = todd.pierzina@collectivehealth.com


