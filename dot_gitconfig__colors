#! .gitconfig

# ui provides the default for all other commands: always|AUTO|never
[color]
  ui = always
  #! advice = always
  #! branch = always
  #! diff   = always
  #! grep   = always
  #! interactive = always
  #! pager = true
  #! push = always
  #! remote = always
  #! showBranch = always
  #! status = always
  #! transport = always

# color.advice and .hint seem to be ignored in Git 2.24.3
[color "advice"]
  hint = dim cyan

[color "blame"]
   highlightRecent = blue,6.months.ago,normal,2.months.ago,yellow,2.weeks.ago,red
   repeatedLines = green  # seems to have no effect

[color "branch"]
  current = magenta   #! green
  #! local = normal
  remote = cyan       #! red
  upstream = blue     #! blue
  #! plain = normal

# From: https://git-scm.com/docs/git-config#Documentation/git-config.txt-colordecorateltslotgt
# LOG/PRETTY FORMAT FIELDS
# %h  - abbrev hash
# %C  - color or reset
# %cn - committer name; %cN via .mailmap
# %ce - committer email; %cE via .mailmap
# %cl - committer email local part; %cL via .mailmap
# %cd - commit date in --date's format
# %cr - commit date (relative)
# %D  - ref name(s)
# %s  - subject line
[color "decorate"]
  #! branch = bold green
  remoteBranch = bold cyan  #! bold red
  tag = bold cyan           #! bold cyan
  stash = white
  #! HEAD = green
  # grafted

